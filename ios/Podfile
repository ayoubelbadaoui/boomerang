# iOS Podfile - FirebaseAuth 11+ requires iOS 15.0 minimum
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting Flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

install! 'cocoapods', :disable_input_output_paths => true

# Prevent Cocoapods from embedding a Flutter framework dynamically.
use_frameworks! :linkage => :static

flutter_root = ENV['FLUTTER_ROOT']
if flutter_root.nil? || flutter_root.empty?
  flutter_executable = `which flutter`.strip
  if flutter_executable.nil? || flutter_executable.empty?
    raise 'Unable to locate Flutter. Ensure Flutter is installed and in your PATH.'
  end
  # path/to/flutter/bin/flutter -> go up 1 level to Flutter SDK root
  flutter_root = File.expand_path('..', File.dirname(flutter_executable))
end
load File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')

target 'Runner' do
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ffmpeg kit (community fork with bundled xcframeworks + dSYMs)
  pod 'ffmpeg-kit-ios-full', :podspec => 'https://raw.githubusercontent.com/luthviar/ffmpeg-kit-ios-full/main/ffmpeg-kit-ios-full.podspec'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Force every pod target to match the app's deployment target so newer
      # Firebase modules (compiled for iOS 15+) link cleanly.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # ffmpeg_kit_flutter_new ships iOS-device arm64 + simulator x86_64 slices.
      # Excluding simulator arm64 forces x86_64 simulator builds and avoids
      # linking device-only arm64 slices when running on Apple Silicon Macs.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'

      # permission_handler: only compile the permissions we actually use so the
      # binary doesn't reference APIs for permissions we don't declare (which
      # can trigger App Store review flags).
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_LOCATION=0',
        'PERMISSION_NOTIFICATIONS=0',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end

  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      end
    end
    project.save
  end
end
