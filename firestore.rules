rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }
    function isUser(uid) {
      return authed() && request.auth.uid == uid;
    }

    // Username -> email login lookup used before authentication.
    // Single-document get is public so users can sign in with username.
    // Listing is denied to reduce bulk enumeration.
    match /login_usernames/{usernameLower} {
      allow get: if true;
      allow list: if false;
      allow create, update: if authed()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if authed() && resource.data.uid == request.auth.uid;
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{uid} {

      function isValidCounterUpdate() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        let counters = ['followersCount', 'followingCount', 'totalLikes', 'boomerangsCount'].toSet();
        return affected.size() > 0
          && affected.hasOnly(counters)
          && (!affected.hasAny(['followersCount'].toSet())
              || request.resource.data.get('followersCount', 0) == resource.data.get('followersCount', 0) + 1
              || request.resource.data.get('followersCount', 0) == resource.data.get('followersCount', 0) - 1)
          && (!affected.hasAny(['followingCount'].toSet())
              || request.resource.data.get('followingCount', 0) == resource.data.get('followingCount', 0) + 1
              || request.resource.data.get('followingCount', 0) == resource.data.get('followingCount', 0) - 1)
          && (!affected.hasAny(['totalLikes'].toSet())
              || request.resource.data.get('totalLikes', 0) == resource.data.get('totalLikes', 0) + 1
              || request.resource.data.get('totalLikes', 0) == resource.data.get('totalLikes', 0) - 1)
          && (!affected.hasAny(['boomerangsCount'].toSet())
              || request.resource.data.get('boomerangsCount', 0) == resource.data.get('boomerangsCount', 0) + 1
              || request.resource.data.get('boomerangsCount', 0) == resource.data.get('boomerangsCount', 0) - 1);
      }

      allow read:           if authed();
      allow create, delete: if isUser(uid);
      allow update:         if isUser(uid) || (authed() && isValidCounterUpdate());

      // ── Likes (per-user liked-post IDs) ─────────────────────────────
      match /likes/{docId} {
        allow read, write: if isUser(uid);
      }

      // ── Notifications ───────────────────────────────────────────────
      // Any authed user can create (like/comment/follow triggers notify)
      match /notifications/{nid} {
        allow read, update, delete: if isUser(uid);
        allow create:               if authed();
      }

      // ── Follow requests ─────────────────────────────────────────────
      // Sender creates; receiver reads, updates (reject), & deletes;
      // sender can also read own request and cancel (delete).
      match /followRequests/{senderId} {
        allow read:   if isUser(uid) || isUser(senderId);
        allow create: if isUser(senderId);
        allow update: if isUser(uid);
        allow delete: if isUser(uid) || isUser(senderId);
      }

      // ── FCM device tokens ───────────────────────────────────────────
      match /deviceTokens/{token} {
        allow read, write: if isUser(uid);
      }

      // ── Blocked users ───────────────────────────────────────────────
      // Owner manages list; blocked user can check if they're blocked
      match /blocked_users/{blockedUid} {
        allow read:  if isUser(uid) || isUser(blockedUid);
        allow write: if isUser(uid);
      }

      // ── Saved / bookmarked posts ────────────────────────────────────
      match /saved/{docId} {
        allow read, write: if isUser(uid);
      }

      // ── App settings ────────────────────────────────────────────────
      match /meta/{docId} {
        allow read, write: if isUser(uid);
      }
    }

    // ── Boomerangs (posts) ────────────────────────────────────────────
    match /boomerangs/{boomerangId} {

      // Private-account gate: public posts are readable by anyone authed;
      // private posts are only readable by the owner or confirmed followers.
      function canReadBoomerang() {
        return authed() && (
          resource.data.ownerIsPrivate != true
          || resource.data.userId == request.auth.uid
          || exists(/databases/$(database)/documents/followers/$(resource.data.userId)/users/$(request.auth.uid))
        );
      }

      allow read:   if canReadBoomerang();
      allow create: if authed() && request.resource.data.userId == request.auth.uid;
      allow update: if authed();
      allow delete: if authed() && resource.data.userId == request.auth.uid;

      // Helper: check parent boomerang privacy for subcollections.
      // Uses get() (counts toward the 10-call-per-evaluation limit).
      function canReadParentBoomerang() {
        let parent = get(/databases/$(database)/documents/boomerangs/$(boomerangId)).data;
        return authed() && (
          parent.ownerIsPrivate != true
          || parent.userId == request.auth.uid
          || exists(/databases/$(database)/documents/followers/$(parent.userId)/users/$(request.auth.uid))
        );
      }

      // Comments
      match /comments/{commentId} {
        function isPostOwner() {
          return get(/databases/$(database)/documents/boomerangs/$(boomerangId)).data.userId == request.auth.uid;
        }

        allow read:   if canReadParentBoomerang();
        allow create: if authed() && request.resource.data.userId == request.auth.uid;
        allow update: if authed();
        allow delete: if authed() && (resource.data.userId == request.auth.uid || isPostOwner());

        // Replies
        match /replies/{replyId} {
          allow read:   if canReadParentBoomerang();
          allow create: if authed() && request.resource.data.userId == request.auth.uid;
          allow update: if authed() && resource.data.userId == request.auth.uid;
          allow delete: if authed() && (resource.data.userId == request.auth.uid || isPostOwner());
        }
      }
    }

    // ── Following (who uid follows) ───────────────────────────────────
    // Both participants may write (follow/unfollow, accept-request, block)
    match /following/{uid} {
      match /users/{targetUid} {
        allow read:  if authed();
        allow write: if authed()
                     && (request.auth.uid == uid || request.auth.uid == targetUid);
      }
    }

    // ── Followers (who follows uid) ───────────────────────────────────
    match /followers/{uid} {
      match /users/{followerUid} {
        allow read:  if authed();
        allow write: if authed()
                     && (request.auth.uid == uid || request.auth.uid == followerUid);
      }
    }

    // ── Conversations & Messages ──────────────────────────────────────
    match /conversations/{conversationId} {
      // Enforce one conversation per participant pair: the document ID must
      // equal the sorted UIDs joined by '_'.
      function isDeterministicId() {
        let p = request.resource.data.participants;
        return p.size() == 2
          && (conversationId == (p[0] + '_' + p[1]));
      }

      allow read:   if authed() && request.auth.uid in resource.data.participants;
      allow create: if authed()
                    && request.auth.uid in request.resource.data.participants
                    && isDeterministicId();
      allow update: if authed() && request.auth.uid in resource.data.participants;
      allow delete: if authed() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read:           if authed() && isParticipant();
        allow create:         if authed() && isParticipant()
                              && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if authed() && isParticipant();
      }
    }

    // ── Hashtags ──────────────────────────────────────────────────────
    match /hashtags/{tag} {
      allow read:           if authed();
      allow create, update: if authed();
    }

    // ── Reports (abuse / content) ─────────────────────────────────────
    match /reports/{reportId} {
      allow create: if authed() && request.resource.data.reporterId == request.auth.uid;
    }

    // ── Data export requests (GDPR) ───────────────────────────────────
    match /data_export_requests/{requestId} {
      allow create: if authed() && request.resource.data.uid == request.auth.uid;
    }

    // ── Rate limits (Cloud Functions admin SDK only) ──────────────────
    match /notificationRateLimits/{key} {
      allow read, write: if false;
    }

    // ── Legacy notification path ──────────────────────────────────────
    match /notifications/{uid} {
      match /items/{nid} {
        allow read, update: if isUser(uid);
      }
    }

    // No wildcard fallback — unlisted collections are denied by default
  }
}
