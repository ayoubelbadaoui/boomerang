rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Helpers to safely read merged values (request overrides resource).
    function mergedString(field) {
      return request.resource.data[field] is string
        ? request.resource.data[field]
        : (resource.data[field] is string ? resource.data[field] : null);
    }

    function mergedBool(field) {
      return request.resource.data[field] is bool
        ? request.resource.data[field]
        : (resource.data[field] is bool ? resource.data[field] : null);
    }

    function validUsernameFields() {
      let username = mergedString('username');
      let usernameLower = mergedString('usernameLower');
      return username != null
        && usernameLower != null
        && username == usernameLower
        && usernameLower.size() >= 3
        && usernameLower.size() <= 20
        && usernameLower.matches('^[a-z0-9._]+$');
    }

    function validNicknameFields() {
      let nickname = mergedString('nickname');
      let nicknameLower = mergedString('nicknameLower');
      return nickname != null
        && nicknameLower != null
        && nickname.lower() == nicknameLower
        && nicknameLower.size() >= 3
        && nicknameLower.size() <= 20
        && nicknameLower.matches('^[a-z0-9._]+$');
    }

    // Optional: pass when field is absent or valid (for stub profile / sign-up flow).
    function optionalUsernameFields() {
      let username = mergedString('username');
      let usernameLower = mergedString('usernameLower');
      return (username == null && usernameLower == null) || validUsernameFields();
    }

    function optionalNicknameFields() {
      let nickname = mergedString('nickname');
      let nicknameLower = mergedString('nicknameLower');
      return (nickname == null && nicknameLower == null) || validNicknameFields();
    }

    function optionalFullNameFields() {
      let fullName = mergedString('fullName');
      let fullNameLower = mergedString('fullNameLower');
      return (fullName == null && fullNameLower == null)
        || (fullName != null && fullNameLower != null && fullName.lower() == fullNameLower);
    }

    // User profiles: only the owner can write; app enforces nickname/username format.
    match /users/{uid} {
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow read: if true;
    }

    // Device tokens for push notifications
    match /users/{uid}/deviceTokens/{token} {
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    // Saved boomerangs per user
    match /users/{uid}/saved/{boomerangId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // User metadata (e.g., settings)
    match /users/{uid}/meta/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Boomerangs (posts) and nested comments/replies
    match /boomerangs/{boomerangId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.auth.uid == request.resource.data.userId;
      // Allow owner updates; allow likes/likedBy changes while keeping ownership intact.
      allow update: if isSignedIn()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;

      // Comments on a boomerang
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.userId is string
          && request.auth.uid == request.resource.data.userId
          && request.resource.data.text is string;
        // Allow likes/likedBy updates while preserving owner.
        allow update: if isSignedIn()
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isSignedIn()
          && request.auth.uid == resource.data.userId;

        // Replies under a comment
        match /replies/{replyId} {
          allow read: if true;
          allow create: if isSignedIn()
            && request.resource.data.userId is string
            && request.auth.uid == request.resource.data.userId
            && request.resource.data.text is string;
          allow update: if isSignedIn()
            && request.resource.data.userId == resource.data.userId;
          allow delete: if isSignedIn()
            && request.auth.uid == resource.data.userId;
        }
      }
    }

    // Notifications per user
    match /users/{uid}/notifications/{nid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.type is string
        && request.resource.data.senderId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.read is bool;
      // Prevent flipping read back to false
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.read == true
        && resource.data.read == false;
      allow delete: if false;
    }

    // Follow requests live under the receiver.
    match /users/{uid}/followRequests/{senderId} {
      allow create: if isSignedIn()
        && request.auth.uid == senderId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.status == 'pending'
        && (request.resource.data.status == 'accepted'
          || request.resource.data.status == 'rejected');
      // Allow either sender or receiver to delete (cancel/reject).
      allow delete: if isSignedIn()
        && (request.auth.uid == uid || request.auth.uid == senderId);
      allow read: if isSignedIn()
        && (request.auth.uid == uid || request.auth.uid == senderId);
    }

    // Following collections
    match /following/{ownerId}/users/{targetId} {
      allow read: if isSignedIn();
      // Owner writes their outgoing follows, or receivers can write when accepting.
      allow write: if isSignedIn()
        && (request.auth.uid == ownerId || request.auth.uid == targetId);
    }

    match /followers/{ownerId}/users/{followerId} {
      allow read: if isSignedIn();
      // Follower writes when following, receiver writes when accepting.
      allow write: if isSignedIn()
        && (request.auth.uid == followerId || request.auth.uid == ownerId);
    }

    // Canonical notifications path used by backend and app
    match /notifications/{uid}/items/{itemId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Allow owner to mark read only; block other writes.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.read == true
        && resource.data.read == false;
      allow create, delete: if false;
    }
  }
}
